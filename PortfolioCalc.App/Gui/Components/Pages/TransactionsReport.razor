@page "/transactions-report"
@using System.Text.Json
@using PortfolioCalc.App.Application.Fx
@using PortfolioCalc.App.Application.Transactions
@using PortfolioCalc.Core.Domain
@using PortfolioCalc.Core.Repositories
@inject ISecurityTransactionRepository SecurityTransactionRepository
@inject ICashTransactionRepository CashTransactionRepository
@inject IUiLayoutSettingRepository LayoutRepository
@inject TransactionDeleteService TransactionDeleteService
@inject TransactionPerformanceService TransactionPerformanceService
@inject BaseCurrencyConversionService BaseCurrencyConversionService
@inject ILogger<TransactionsReport> Logger
@inject NavigationManager NavigationManager

<h1>Transactions</h1>

@if (_error is not null)
{
    <p class="text-danger">@_error</p>
}
else
{
    <p>
        <strong>Columns:</strong>
        @foreach (var column in _columns)
        {
            <span class="me-3">
                <input type="checkbox" id="@("col-" + column.Key)" checked="@column.Visible"
                       @onchange="e => ToggleColumnAsync(column, (bool)e.Value!)" />
                <label for="@("col-" + column.Key)">@column.Label</label>
                <button class="btn btn-sm btn-link p-0" title="Move left" disabled="@(_columns.IndexOf(column) == 0)"
                        @onclick="() => MoveColumnAsync(column, -1)">&larr;</button>
                <button class="btn btn-sm btn-link p-0" title="Move right" disabled="@(_columns.IndexOf(column) == _columns.Count - 1)"
                        @onclick="() => MoveColumnAsync(column, 1)">&rarr;</button>
            </span>
        }
    </p>

    <p>
        <input type="checkbox" id="show-secondary" checked="@_showSecondary"
               @onchange="e => ToggleShowSecondaryAsync((bool)e.Value!)" />
        <label for="show-secondary">Show income/fee transactions too (Tax, Interest, Dividend)</label>
    </p>

    <p>
        <input type="checkbox" id="show-analytics" checked="@_showAnalytics" @onchange="e => ToggleShowAnalyticsAsync((bool)e.Value!)" />
        <label for="show-analytics">Show analytics</label>
        @if (_showAnalytics)
        {
            <span class="ms-3">
                <input type="checkbox" id="inflation-adjusted" checked="@_inflationAdjusted"
                       @onchange="e => ToggleInflationAdjustedAsync((bool)e.Value!)" />
                <label for="inflation-adjusted">Inflation-adjusted (to today's prices)</label>
            </span>
        }
    </p>

    <table class="table">
        <thead>
            <tr>
                @foreach (var column in _columns.Where(c => c.Visible))
                {
                    <th style="cursor: pointer" @onclick="() => SortByAsync(column.Key)">
                        @column.Label@(_sortKey == column.Key ? (_sortDescending ? " ▼" : " ▲") : "")
                    </th>
                }
                @if (_showAnalytics)
                {
                    <th>CAGR (@_baseCurrency)</th>
                    <th>Cash flow result (@_baseCurrency)</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _sortedRows)
            {
                var performance = row.TransactionId is not null ? _performanceByTransactionId.GetValueOrDefault(row.TransactionId.Value) : null;
                <tr>
                    @foreach (var column in _columns.Where(c => c.Visible))
                    {
                        <td class="@(IsNumericColumn(column.Key) ? "text-end" : "")">@FormatCell(row, column.Key)</td>
                    }
                    @if (_showAnalytics)
                    {
                        <td class="text-end">@(performance?.Cagr is { } cagr ? cagr.ToString("P2") : "")</td>
                        <td class="text-end">@(performance?.CashFlowResult is { } cashFlow ? cashFlow.ToString("N2") : "")</td>
                    }
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            @if (row.SecurityId is not null)
                            {
                                <button class="btn btn-outline-secondary" @onclick="() => GoToChart(row)">Chart</button>
                            }
                            <button class="btn btn-outline-danger" @onclick="() => DeleteRowAsync(row)">Delete</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const string ScreenKey = "TransactionsReport";

    private record TransactionRow(
        DateOnly Date, string Kind, TransactionCategory Category, string Account, string? Security,
        decimal? Quantity, decimal Amount, string Currency, decimal? Fee, string? Note, int? SecurityId,
        int? TransactionId, int? CashTransactionId);

    private class ColumnState
    {
        public required string Key { get; init; }
        public required string Label { get; init; }
        public bool Visible { get; set; } = true;
    }

    private class SavedColumn
    {
        public required string Key { get; set; }
        public bool Visible { get; set; }
    }

    private class SavedLayout
    {
        public List<SavedColumn> Columns { get; set; } = [];
        public string? SortKey { get; set; }
        public bool SortDescending { get; set; }

        /// <summary>Added after this screen's layout was first shipped — missing in
        /// already-saved JSON deserializes to false (System.Text.Json's default for a
        /// bool it doesn't find), which is also this filter's intended default.</summary>
        public bool ShowSecondary { get; set; }
    }

    private List<ColumnState> _columns =
    [
        new() { Key = "Date", Label = "Date" },
        new() { Key = "Kind", Label = "Type" },
        new() { Key = "Account", Label = "Account" },
        new() { Key = "Security", Label = "Security" },
        new() { Key = "Quantity", Label = "Quantity" },
        new() { Key = "Amount", Label = "Amount" },
        new() { Key = "Currency", Label = "Currency" },
        new() { Key = "Fee", Label = "Fee" },
        new() { Key = "Note", Label = "Note" },
    ];

    private IReadOnlyList<TransactionRow> _rows = [];
    private IReadOnlyList<TransactionRow> _sortedRows = [];
    private string _sortKey = "Date";
    private bool _sortDescending;
    private bool _showSecondary;
    private bool _showAnalytics;
    private bool _inflationAdjusted;
    private DateOnly _today;
    private string _baseCurrency = "";
    private Dictionary<int, SecurityTransaction> _buyTransactionsById = [];
    private Dictionary<int, BuyTransactionPerformance> _performanceByTransactionId = [];
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _today = DateOnly.FromDateTime(DateTime.UtcNow);
            _baseCurrency = await BaseCurrencyConversionService.GetBaseCurrencyAsync();
            await LoadLayoutAsync();
            await LoadRowsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the transactions report.");
            _error = "Could not load transactions. See the Logs page for details.";
        }
    }

    private async Task LoadLayoutAsync()
    {
        var saved = await LayoutRepository.GetAsync(ScreenKey);
        if (saved is null)
            return;

        var layout = JsonSerializer.Deserialize<SavedLayout>(saved.LayoutJson);
        if (layout is null)
            return;

        var byKey = _columns.ToDictionary(c => c.Key);
        var ordered = new List<ColumnState>();
        foreach (var savedColumn in layout.Columns)
        {
            if (!byKey.TryGetValue(savedColumn.Key, out var column))
                continue;
            column.Visible = savedColumn.Visible;
            ordered.Add(column);
        }
        foreach (var column in _columns)
        {
            if (!ordered.Contains(column))
                ordered.Add(column);
        }
        _columns = ordered;

        _sortKey = layout.SortKey ?? _sortKey;
        _sortDescending = layout.SortDescending;
        _showSecondary = layout.ShowSecondary;
    }

    private async Task SaveLayoutAsync()
    {
        var layout = new SavedLayout
        {
            Columns = _columns.Select(c => new SavedColumn { Key = c.Key, Visible = c.Visible }).ToList(),
            SortKey = _sortKey,
            SortDescending = _sortDescending,
            ShowSecondary = _showSecondary,
        };
        await LayoutRepository.SaveAsync(ScreenKey, JsonSerializer.Serialize(layout));
    }

    private async Task LoadRowsAsync()
    {
        var securityTransactions = await SecurityTransactionRepository.GetAllAsync();
        var cashTransactions = await CashTransactionRepository.GetAllAsync();

        var rows = securityTransactions
            .Select(t => new TransactionRow(
                t.Date, t.Type.ToString(), TransactionCategoryClassifier.Classify(t.Type),
                t.Position!.Account!.Name, t.Position.Security!.Symbol,
                t.Quantity, t.Amount, t.Currency, t.FeeAmount, t.Note, t.Position.Security.Id, t.Id, null))
            .Concat(cashTransactions
                .Select(t => new TransactionRow(
                    t.Date, t.Type.ToString(), TransactionCategoryClassifier.Classify(t.Type),
                    t.Account!.Name, null,
                    null, t.Amount, t.Currency, t.FeeAmount, t.Note, null, null, t.Id)))
            .ToList();

        _rows = rows;
        _buyTransactionsById = securityTransactions
            .Where(t => t.Type == SecurityTransactionType.Buy)
            .ToDictionary(t => t.Id);
        ApplySort();
    }

    private async Task ToggleShowAnalyticsAsync(bool show)
    {
        _showAnalytics = show;
        if (_showAnalytics)
            await LoadPerformanceAsync();
    }

    private async Task ToggleInflationAdjustedAsync(bool inflationAdjusted)
    {
        _inflationAdjusted = inflationAdjusted;
        await LoadPerformanceAsync();
    }

    private async Task LoadPerformanceAsync()
    {
        try
        {
            var byTransactionId = new Dictionary<int, BuyTransactionPerformance>();
            foreach (var transaction in _buyTransactionsById.Values)
            {
                byTransactionId[transaction.Id] = await TransactionPerformanceService.GetBuyPerformanceAsync(
                    transaction, _inflationAdjusted, _today);
            }
            _performanceByTransactionId = byTransactionId;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load transaction analytics.");
            _error = "Could not load transaction analytics. See the Logs page for details.";
        }
    }

    private void ApplySort()
    {
        var filtered = _rows.Where(r => _showSecondary || r.Category == TransactionCategory.Primary);

        IEnumerable<TransactionRow> ordered = _sortKey switch
        {
            "Kind" => filtered.OrderBy(r => r.Kind),
            "Account" => filtered.OrderBy(r => r.Account),
            "Security" => filtered.OrderBy(r => r.Security),
            "Quantity" => filtered.OrderBy(r => r.Quantity),
            "Amount" => filtered.OrderBy(r => r.Amount),
            "Currency" => filtered.OrderBy(r => r.Currency),
            "Fee" => filtered.OrderBy(r => r.Fee),
            "Note" => filtered.OrderBy(r => r.Note),
            _ => filtered.OrderBy(r => r.Date),
        };
        _sortedRows = (_sortDescending ? ordered.Reverse() : ordered).ToList();
    }

    private async Task SortByAsync(string key)
    {
        if (_sortKey == key)
            _sortDescending = !_sortDescending;
        else
        {
            _sortKey = key;
            _sortDescending = false;
        }
        ApplySort();
        await SaveLayoutAsync();
    }

    private async Task ToggleColumnAsync(ColumnState column, bool visible)
    {
        column.Visible = visible;
        await SaveLayoutAsync();
    }

    private async Task ToggleShowSecondaryAsync(bool show)
    {
        _showSecondary = show;
        ApplySort();
        await SaveLayoutAsync();
    }

    private async Task MoveColumnAsync(ColumnState column, int direction)
    {
        var index = _columns.IndexOf(column);
        var newIndex = index + direction;
        if (newIndex < 0 || newIndex >= _columns.Count)
            return;

        _columns.RemoveAt(index);
        _columns.Insert(newIndex, column);
        await SaveLayoutAsync();
    }

    private static bool IsNumericColumn(string key) => key is "Quantity" or "Amount" or "Fee";

    private static string FormatCell(TransactionRow row, string key) => key switch
    {
        "Date" => row.Date.ToString("yyyy-MM-dd"),
        "Kind" => row.Kind,
        "Account" => row.Account,
        "Security" => row.Security ?? "",
        "Quantity" => FormatQuantity(row.Quantity),
        "Amount" => row.Amount.ToString("N2"),
        "Currency" => row.Currency,
        "Fee" => row.Fee?.ToString("N2") ?? "",
        "Note" => row.Note ?? "",
        _ => "",
    };

    /// <summary>Navigates to the position value chart (story 10) prefilled from this row —
    /// security, transaction date as the chart's start date, and its quantity as the number
    /// of shares (defaulting to 1 for a row with no quantity, e.g. a Dividend).</summary>
    private void GoToChart(TransactionRow row)
    {
        var shares = row.Quantity ?? 1m;
        NavigationManager.NavigateTo(
            $"position-chart?securityId={row.SecurityId}&startDate={row.Date:yyyy-MM-dd}&shares={shares}");
    }

    private async Task DeleteRowAsync(TransactionRow row)
    {
        try
        {
            if (row.TransactionId is not null)
                await TransactionDeleteService.DeleteSecurityTransactionAsync(row.TransactionId.Value);
            else if (row.CashTransactionId is not null)
                await TransactionDeleteService.DeleteCashTransactionAsync(row.CashTransactionId.Value);

            await LoadRowsAsync();
            if (_showAnalytics)
                await LoadPerformanceAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete a transaction from the transactions report.");
            _error = "Could not delete the transaction. See the Logs page for details.";
        }
    }

    /// <summary>No decimal places for a whole number (e.g. "143"), exactly 2 otherwise
    /// (e.g. "142.50") — matches this project's existing "N2" numeric convention
    /// (PortfolioValueReport.razor) while not padding whole-share quantities.</summary>
    private static string FormatQuantity(decimal? quantity)
    {
        if (quantity is null)
            return "";
        var value = quantity.Value;
        return value == Math.Truncate(value) ? value.ToString("N0") : value.ToString("N2");
    }
}
