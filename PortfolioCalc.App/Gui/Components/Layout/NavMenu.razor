@implements IDisposable
@inject PortfolioCalc.App.Logging.LogActivityTracker LogActivityTracker

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Portfolio Calculator</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="import">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Import
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="transactions-report">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Transactions
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="portfolio-value-report">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Portfolio Value
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="position-chart">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Security Performance Chart
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="tax-estimation-report">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Tax Estimation
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Settings
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="validation-review">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Validation Review
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="vocabularies">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Vocabularies
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="logs">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Logs
                @if (LogActivityTracker.HasUnseenEntries)
                {
                    <span class="badge bg-danger ms-1">New</span>
                }
            </NavLink>
        </div>
    </nav>
</div>

@code {
    protected override void OnInitialized() => LogActivityTracker.Changed += OnLogActivityChanged;

    // The tracker's Changed event may fire from a background/logging thread (a warning can
    // be logged from anywhere in the app), so the UI update is marshalled back via
    // InvokeAsync rather than calling StateHasChanged directly.
    private void OnLogActivityChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => LogActivityTracker.Changed -= OnLogActivityChanged;
}
