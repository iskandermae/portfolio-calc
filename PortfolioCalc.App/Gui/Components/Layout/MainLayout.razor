@inherits LayoutComponentBase
@implements IDisposable
@using PortfolioCalc.App.Application.Caching
@inject NavigationManager NavigationManager
@inject ExternalCallCache ExternalCallCache

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized() => NavigationManager.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => ExternalCallCache.Clear();

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
