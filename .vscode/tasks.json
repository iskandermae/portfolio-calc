{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build PortfolioCalc.App",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}\\PortfolioCalc.App\\PortfolioCalc.App.csproj",
                "/property:GenerateFullPaths=true",
                "/p:Configuration=Debug",
                "/p:Platform=AnyCPU",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}